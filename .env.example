# Copy this file to ".env" and fill in your real values.
# .env is git-ignored -- .env.example is the only one that should be committed.

# --- API Keys ---
GEMINI_API_KEY=your_gemini_api_key_here
PEXELS_API_KEY=your_pexels_api_key_here

# --- Gemini ---
GEMINI_MODEL=gemini-2.5-pro
# Explicit pause (seconds, plus jitter) between the Stage 1 and Stage 2
# calls inside 01_plan.py, on top of per-call retry/backoff.
STAGE_TRANSITION_PAUSE_SEC=3

# --- TTS ---
TTS_VOICE=en-US-ChristopherNeural

# --- Render / hardware tuning ---
# Cap parallel FFmpeg workers -- keep this low on U-series laptop CPUs
# (e.g. i7-1355U) to avoid thermal throttling. 4-6 is a safe range.
MAX_RENDER_WORKERS=4

# "h264_qsv" if your FFmpeg build supports Intel Quick Sync (check with
# `ffmpeg -encoders | findstr qsv`), otherwise "libx264".
VIDEO_ENCODER=libx264

# --- Output format ---
OUTPUT_WIDTH=1920
OUTPUT_HEIGHT=1080
OUTPUT_FPS=30

# --- Pexels rate limiting ---
# Free tier caps at 200 req/hr -- this keeps sequential resolution
# comfortably under that with headroom for retries.
PEXELS_MAX_REQ_PER_HOUR=180

# --- Paths ---
# Every build gets its own projects/<topic-slug>/ workspace under this root.
PROJECTS_DIR=./projects
# 3 royalty-free instrumental tracks live here, named to match the moods
# Gemini can choose from: corporate_tension.mp3, dark_suspense.mp3,
# slow_investigation.mp3
MUSIC_DIR=./assets/music
